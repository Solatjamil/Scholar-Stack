# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# VITE_API_BASE_URL: Absolute URL of the deployed ScholarStack backend.
# LEAVE EMPTY for the web app (same-origin /api calls).
# REQUIRED before `npm run android:sync`, otherwise the Android WebView
# cannot reach /api/predict-exam and /api/bise-datesheet.
# Example: https://scholarstack-xxxxx.a.run.app
VITE_API_BASE_URL=

# --- FIREBASE (optional) ---------------------------------------------------
# Leave these EMPTY to run in local mode: profiles and chapter progress are
# stored in localStorage and the whole app works offline. No backend needed.
#
# Set them to enable cloud sync across devices. Create a Firebase project at
# https://console.firebase.google.com, enable Email/Password (and Google)
# under Authentication > Sign-in method, create a Firestore database, then
# copy the web app config values here. On Vercel add the same keys under
# Settings > Environment Variables and redeploy.
#
# NOTE: the config bundled in src/firebase-applet-config.json belongs to the
# original AI Studio scaffold and its API key has been revoked. It is ignored
# at runtime; these variables are the only supported way to enable cloud sync.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Only needed for a non-default Firestore database ID.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
