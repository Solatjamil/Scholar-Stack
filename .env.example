# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# VITE_API_BASE_URL: Absolute URL of the deployed ScholarStack backend.
# LEAVE EMPTY for the web app (same-origin /api calls).
# REQUIRED before `npm run android:sync`, otherwise the Android WebView
# cannot reach /api/predict-exam and /api/bise-datesheet.
# Example: https://scholarstack-xxxxx.a.run.app
VITE_API_BASE_URL=
